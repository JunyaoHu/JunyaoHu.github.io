/* ═══════════ web browser + link routing ═══════════ */
// 站内页面（博客、论文 PDF、相册页…）在桌面里的浏览器窗口打开；站外链接一律新标签页打开，
// 这样访客不会离开桌面、也不用重新登录。
let nextBrowserUrl = '/blog';
function openBrowser(url) {
	nextBrowserUrl = url;
	const existed = !!wins.browser;
	const w = openWin('browser');
	if (existed) browserGo(w, url, true);
}
// 窗口自己维护前进 / 后退记录，换页用 location.replace：不写入浏览器的总历史，
// 所以窗口里的「‹ ›」只在窗口内翻页，永远不会把整个桌面页面带走。
function browserGo(w, url, push) {
	const st = w.state;
	if (push) { st.hist = st.hist.slice(0, st.idx + 1); st.hist.push(url); st.idx = st.hist.length - 1; }
	const fr = w.el.querySelector('iframe');
	try { fr.contentWindow.location.replace(url); } catch (e) { fr.src = url; }
	w.el.querySelector('.ext').href = url;
	syncNav(w);
}
function syncNav(w) {
	const bar = w.el.querySelector('.br-bar');
	bar.querySelector('[data-b="back"]').disabled = w.state.idx <= 0;
	bar.querySelector('[data-b="fwd"]').disabled = w.state.idx >= w.state.hist.length - 1;
}
function browserMount(w) {
	const fr = w.el.querySelector('iframe'), bar = w.el.querySelector('.br-url');
	const cur = () => { try { return fr.contentWindow.location; } catch (e) { return null; } };
	syncNav(w);
	fr.addEventListener('load', () => {
		const loc = cur();
		if (loc) {
			const url = loc.pathname + loc.search + loc.hash;
			w.state.hist[w.state.idx] = url; // 重定向等情况：就地更新当前记录
			w.el.querySelector('.ext').href = url;
			bar.innerHTML = `${esc(location.host)}<b>${esc(decodeURIComponent(url))}</b>`;
		}
		let t = '';
		try { t = fr.contentDocument.title; } catch (e) {}
		w.state.title = t || 'Web Browser';
		w.el.querySelector('.t').textContent = w.state.title;
		try { fr.contentDocument.addEventListener('click', e => routeLink(e, true), true); } catch (e) {}
	});
	w.el.querySelector('.br-bar').addEventListener('click', e => {
		const b = e.target.closest('[data-b]'); if (!b || b.disabled) return;
		const st = w.state;
		if (b.dataset.b === 'back') { st.idx--; browserGo(w, st.hist[st.idx], false); }
		if (b.dataset.b === 'fwd') { st.idx++; browserGo(w, st.hist[st.idx], false); }
		if (b.dataset.b === 'reload') try { fr.contentWindow.location.reload(); } catch (err) {}
	});
}
function routeLink(e, fromFrame) {
	const a = e.target.closest && e.target.closest('a[href]');
	if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
	if (!/^https?:$/.test(a.protocol)) return; // mailto: 等保持默认
	const newTab = () => { a.target = '_blank'; a.rel = 'noopener'; }; // 让浏览器自己新开标签页
	if (a.origin !== location.origin) return newTab(); // 站外链接
	if (a.target === '_blank') return; // 明确要求新标签页的站内链接（如 Open original site）
	const path = a.pathname.replace(/\/$/, '');
	if (path === '' && fromFrame) { e.preventDefault(); wins.browser && wins.browser.el.querySelector('.x').click(); return; } // 经典页里的「Desktop」按钮：关掉浏览器窗口
	if (path === '/classic' && !fromFrame) return newTab(); // 经典主页也开新标签页，桌面保持不动
	if (a.getAttribute('href').startsWith('#')) return; // 页内锚点（目录等）保持默认
	e.preventDefault();
	const url = a.pathname + a.search + a.hash;
	if (fromFrame) browserGo(wins.browser, url, true); // 窗口内的站内跳转，记入窗口自己的历史
	else openBrowser(url);
}
document.addEventListener('click', e => routeLink(e, false), true);

/* ═══════════ window manager ═══════════ */
let z = 10, cascade = 0;
const wins = {};
const desktop = document.getElementById('desktop');
function openWin(id, app) {
	app = app || APPS[id];
	closeMenus();
	if (wins[id]) { wins[id].el.classList.remove('min'); focus(id); return wins[id]; }
	const el = document.createElement('div');
	el.className = 'win';
	const dw = innerWidth, dh = innerHeight - 32;
	const W = Math.min(app.w, dw - 24), H = Math.min(app.h, dh - 24);
	el.style.width = W + 'px'; el.style.height = H + 'px';
	el.style.left = Math.max(10, (dw - W) / 2 - 40 + (cascade % 5) * 32) + 'px';
	el.style.top = Math.max(10, (dh - H) / 2 - 30 + (cascade % 5) * 26) + 'px';
	cascade++;
	const X = '<svg viewBox="0 0 10 10">';
	el.innerHTML = `<div class="hb"><span class="t"></span><div class="ctl"><button class="mn" title="Minimize">${X}<path d="M1 5h8"/></svg></button><button class="mx" title="Maximize">${X}<rect x="1.5" y="1.5" width="7" height="7"/></svg></button><button class="x" title="Close">${X}<path d="M2 2l6 6M8 2l-6 6"/></svg></button></div></div><div class="content"></div>`;
	desktop.appendChild(el);
	const w = (wins[id] = { id, el, app, state: app.state ? app.state() : {} });
	el.addEventListener('pointerdown', () => focus(id));
	el.querySelector('.x').onclick = e => { e.stopPropagation(); el.remove(); delete wins[id]; updateAppName(); };
	el.querySelector('.mn').onclick = e => { e.stopPropagation(); el.classList.add('min'); el.dataset.active = ''; updateAppName(); };
	el.querySelector('.mx').onclick = () => el.classList.toggle('max');
	el.querySelector('.hb').ondblclick = () => el.classList.toggle('max');
	if (app.click) el.querySelector('.content').addEventListener('click', e => app.click(w, e));
	drag(el, el.querySelector('.hb'));
	refresh(w);
	app.mount && app.mount(w);
	focus(id);
	return w;
}
function refresh(w) {
	w.el.querySelector('.t').textContent = w.app.title(w);
	w.el.querySelector('.content').innerHTML = w.app.render(w);
}
function focus(id) {
	Object.values(wins).forEach(x => (x.el.dataset.active = ''));
	wins[id].el.style.zIndex = ++z; wins[id].el.dataset.active = '1';
	updateAppName();
}
function drag(el, handle) {
	handle.addEventListener('pointerdown', e => {
		if (e.target.closest('button') || el.classList.contains('max') || innerWidth <= 680) return;
		const sx = e.clientX - el.offsetLeft, sy = e.clientY - el.offsetTop;
		document.body.classList.add('dragging');
		const move = ev => { el.style.left = ev.clientX - sx + 'px'; el.style.top = Math.max(0, ev.clientY - sy) + 'px'; };
		const up = () => { document.body.classList.remove('dragging'); removeEventListener('pointermove', move); removeEventListener('pointerup', up); };
		addEventListener('pointermove', move); addEventListener('pointerup', up);
	});
}
// 顶栏左侧：显示当前聚焦窗口的应用名（GNOME 风格），不再是「活动」按钮
function updateAppName() {
	const a = Object.values(wins).find(x => x.el.dataset.active === '1' && !x.el.classList.contains('min'));
	document.getElementById('appName').textContent = a ? a.app.label : 'Junyao Hu';
}

/* ═══════════ desktop icons / menu / clock ═══════════ */
// 左侧：看内容（关于 / 论文 / 博客 / 相册 / 动态）；右侧：互动（留言 / 朋友 / 对话）；回收站在左下角
