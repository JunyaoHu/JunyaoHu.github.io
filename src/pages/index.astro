/* ═══════════ generated wallpaper ═══════════ */
// 固定种子：每次打开都是同一张壁纸
const P = ['#2c001e', '#77216f', '#e95420', '#ffb36b'];
let seed = 20260329;
const rnd = (a, b) => { seed = (seed * 16807) % 2147483647; return a + (seed / 2147483647) * (b - a); };
function genWallpaper() {
	const W = 1920, H = 1080;
	const wave = (y0, amp, f, ph) => {
		let d = `M0 ${y0.toFixed(1)}`;
		for (let x = 0; x <= W; x += 32) {
			const y = y0 + Math.sin((x / W) * Math.PI * 2 * f + ph) * amp + Math.sin((x / W) * Math.PI * 5.3 * f + ph * 1.7) * amp * 0.22;
			d += ` L${x} ${y.toFixed(1)}`;
		}
		return d;
	};
	let stars = '', bokeh = '', fills = '', lines = '';
	for (let i = 0; i < 70; i++) stars += `<circle cx="${rnd(0, W).toFixed(0)}" cy="${rnd(0, H * 0.55).toFixed(0)}" r="${rnd(0.6, 2.2).toFixed(1)}" fill="#fff" opacity="${rnd(0.08, 0.5).toFixed(2)}"/>`;
	for (let i = 0; i < 7; i++) bokeh += `<circle cx="${rnd(0, W).toFixed(0)}" cy="${rnd(0, H).toFixed(0)}" r="${rnd(60, 220).toFixed(0)}" fill="${P[3]}" opacity="${rnd(0.03, 0.08).toFixed(2)}"/>`;
	const n = 6;
	for (let i = 0; i < n; i++) {
		const y0 = H * (0.42 + i * 0.09) + rnd(-50, 50);
		fills += `<path d="${wave(y0, rnd(50, 150), rnd(0.5, 1.4), rnd(0, 6.28))} L${W} ${H} L0 ${H} Z" fill="url(#w${i % 2})" opacity="${rnd(0.2, 0.42).toFixed(2)}"/>`;
	}
	const baseY = H * rnd(0.45, 0.6), amp = rnd(80, 160), f = rnd(0.6, 1.1), ph = rnd(0, 6.28);
	for (let i = 0; i < 18; i++) lines += `<path d="${wave(baseY + i * 9, amp + i * 4, f, ph + i * 0.05)}" fill="none" stroke="#fff" stroke-width="1.2" opacity="${(0.03 + (i % 5) * 0.012).toFixed(3)}"/>`;
	return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
		<defs>
			<linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${P[0]}"/><stop offset=".6" stop-color="${P[1]}"/><stop offset="1" stop-color="${P[2]}"/></linearGradient>
			<radialGradient id="glow" cx="${rnd(0.6, 0.9).toFixed(2)}" cy="${rnd(0.1, 0.3).toFixed(2)}" r=".65"><stop offset="0" stop-color="${P[3]}" stop-opacity=".55"/><stop offset="1" stop-color="${P[3]}" stop-opacity="0"/></radialGradient>
			<linearGradient id="w0" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="${P[2]}"/><stop offset="1" stop-color="${P[1]}"/></linearGradient>
			<linearGradient id="w1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${P[1]}"/><stop offset="1" stop-color="${P[3]}"/></linearGradient>
		</defs>
		<rect width="${W}" height="${H}" fill="url(#bg)"/><rect width="${W}" height="${H}" fill="url(#glow)"/>
		${stars}${bokeh}${fills}${lines}
	</svg>`;
}

