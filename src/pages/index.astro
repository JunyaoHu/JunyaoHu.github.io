	const side = [['home', 'home', 'Home'], ['papers', 'papers', 'Publications'], ['blog', 'blog', 'Blog'], ['photos', 'photosFolder', 'Photos'], ['trash', 'trash', 'Trash']]
		.map(([k, ic, n]) => `<div class="pl ${loc === k || false ? 'on' : ''}" data-go="${k}">${icon(ic)}<span>${n}</span></div>`).join('');
	let body = '', foot = '';
	if (loc === 'home') {
		body = `<div class="grid">
			<div class="fi" data-go="papers">${icon('papers')}<span>Publications</span></div>
			<div class="fi" data-go="blog">${icon('blog')}<span>Blog</span></div>
			<div class="fi" data-go="photos">${icon('photosFolder')}<span>Photos</span></div>
			<div class="fi" data-open="about">${icon('md')}<span>README.md</span></div>
			<div class="fi" data-open="news">${icon('doc')}<span>news.ics</span></div>
		</div>`;
		foot = '5 items';
	} else if (loc === 'papers') {
		const opts = [['all', 'All'], ['first', 'First author'], ['co-first', 'Co-first author'], ['other', 'Others']];
		const chips = opts.map(([id, l]) => `<button data-pf="${id}" class="${w.state.pf === id ? 'on' : ''}">${l}<small>(${id === 'all' ? PAPERS.length : PAPERS.filter(p => p.filter === id).length})</small></button>`).join('');
		const rows = PAPERS.map((p, i) => [p, i]).filter(([p]) => w.state.pf === 'all' || p.filter === w.state.pf)
			.map(([p, i]) => `<div class="row" data-paper="${i}">${icon('pdf')}<div><div class="nm">${p.title}</div><div class="sub">${p.role}${p.year ? ' · ' + p.year : ''}</div></div><span class="vn">${p.venue}</span></div>`).join('');
		body = `<div class="chips">${chips}</div><div class="rows">${rows || '<p class="dim pad">No papers in this category.</p>'}</div>`;
		foot = 'Note: # = Equal Contribution, * = Corresponding Author.';
	} else if (loc === 'blog') {
		const chips = [['all', 'All', POSTS.length], ...POST_CATS.map(c => [c, c, POSTS.filter(p => p.category === c).length])]
			.map(([id, l, n]) => `<button data-bf="${esc(id)}" class="${w.state.bf === id ? 'on' : ''}">${esc(l)}<small>(${n})</small></button>`).join('');
		const rows = POSTS.filter(p => w.state.bf === 'all' || p.category === w.state.bf)
			.map(p => `<a class="row post" href="/blog/${p.id}/">${icon('md')}<div><div class="nm">${esc(p.title)}</div><div class="sub">${esc(p.category)}</div></div><span class="dt">${p.date}</span></a>`).join('');
		body = `<div class="chips">${chips}</div><div class="rows">${rows}</div>`;
		foot = '<a href="/blog" target="_blank">Open the full blog ↗</a>';
	}
	return `<div class="files"><aside>${side}</aside><main><div class="crumb">${crumbs.map(c => `<span class="c" data-go="${c}">${locName(c)}</span>`).join('<span>›</span>')}</div>${body}<div class="foot">${foot}</div></main></div>`;
}
function filesClick(w, e) {
