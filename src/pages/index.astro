/* ═══════════ Junyao Code — Claude Code 风格的脚本化对话（不接真实 AI） ═══════════ */
function ccMount(w) {
	const c = w.el, inp = c.querySelector('.cc-box input');
	w.cc = { busy: false, skip: false };
	setTimeout(() => inp.focus(), 60);
	c.querySelector('.cc').addEventListener('click', e => {
		const b = e.target.closest('.cc-chips button');
		if (b) ccSubmit(w, b.textContent);
		else if (!getSelection().toString() && !e.target.closest('a')) inp.focus();
	});
	inp.addEventListener('keydown', e => {
		if (e.key === 'Enter') ccSubmit(w, inp.value);
		if (e.key === 'Escape' && w.cc.busy) w.cc.skip = true;
		if (e.key === '?' && !inp.value) { e.preventDefault(); ccSubmit(w, '/help'); }
	});
}
const sleep = ms => new Promise(r => setTimeout(r, ms));
async function ccSubmit(w, q) {
	q = q.trim();
	const c = w.el, log = c.querySelector('.cc-log'), sc = c.querySelector('.cc-scroll'), inp = c.querySelector('.cc-box input');
	if (!q || w.cc.busy) return;
	inp.value = '';
	const add = html => { const d = document.createElement('div'); d.innerHTML = html; log.appendChild(d.firstElementChild); sc.scrollTop = sc.scrollHeight; return log.lastElementChild; };
	add(`<div class="cc-user">&gt; ${esc(q)}</div>`);
	if (q === '/clear') { log.innerHTML = ''; return; }
	w.cc.busy = true; w.cc.skip = false; c.classList.add('busy');

	const steps = answer(q);
	const verbs = ['Pondering', 'Reading papers', 'Brewing coffee', 'Synthesizing', 'Recalling'];
	const sp = add(`<div class="cc-spin"><span class="s">✻</span> <span>${verbs[Math.floor(Math.random() * verbs.length)]}…</span> <span class="dim">(esc to interrupt)</span></div>`);
	const glyphs = ['·', '✢', '✳', '✶', '✻', '✽', '✻', '✶', '✳', '✢'];
	let gi = 0;
	const spin = setInterval(() => (sp.querySelector('.s').textContent = glyphs[gi++ % glyphs.length]), 110);
	for (let t = 0; t < 900 + Math.random() * 600 && !w.cc.skip; t += 50) await sleep(50);
	clearInterval(spin); sp.remove();

	for (const s of steps) {
		if (s.tool) {
			add(`<div class="cc-tool"><span class="dot">⏺</span> <b>${s.tool[0]}</b>(${esc(s.tool[1])})</div>`);
			add(`<div class="cc-out">  ⎿  ${s.out}</div>`);
			if (!w.cc.skip) await sleep(320);
		}
		if (s.text) {
			const m = add(`<div class="cc-msg"><span class="dot">⏺</span><div class="body"></div></div>`);
			await stream(w, m.querySelector('.body'), s.text, sc);
		}
		if (s.act) s.act();
	}
	w.cc.busy = false; c.classList.remove('busy');
	inp.focus();
}
async function stream(w, el, html, sc) {
	const toks = html.match(/<[^>]+>|&[a-z#0-9]+;|[\s\S]/gi) || [];
	let buf = '';
	for (let i = 0; i < toks.length; i++) {
		buf += toks[i];
		if (w.cc.skip) continue;
		if (i % 3 === 0) { el.innerHTML = buf; sc.scrollTop = sc.scrollHeight; await sleep(12); }
	}
	el.innerHTML = buf; sc.scrollTop = sc.scrollHeight;
	el.querySelectorAll('a[href]').forEach(a => { a.target = '_blank'; a.rel = 'noopener'; });
}

const OPEN_TARGETS = [[/photo|gallery|picture|album/i, 'gallery'], [/friend|contact/i, 'friends'], [/guestbook|message|comment/i, 'guestbook'], [/paper|publication/i, 'papers'], [/blog|post/i, 'blog'], [/news|calendar/i, 'news'], [/readme|about/i, 'about'], [/file|home/i, 'files'], [/trash/i, 'trash']];
function openTarget(k) { if (k === 'papers') openFiles('papers'); else if (k === 'blog') openFiles('blog'); else openWin(k); }
function paperText(p) {
	const links = p.links.map(([l, h]) => `<a href="${h}" target="_blank">${l}</a>`).join(' · ');
	return `<b>${p.title}</b> (${p.venue}, ${p.role.toLowerCase()})\n${p.tldr}${links ? '\n' + links : ''}`;
}
function answer(q) {
	const has = re => re.test(q);
	if (/^\/?help$/i.test(q)) return [{ text: [
		'Try asking me:',
		'  • who are you?',
		'  • what are you working on?',
		'  • any recent news?',
		'  • how can I contact you?',
		'  • open photos / blog / guestbook',
		'Commands: <b>/whoami</b> · <b>/clear</b> · <b>/help</b>',
		'<span class="dim">…and a few hidden replies left for you to discover 😉</span>',
	].join('\n') }];
	const om = q.match(/^open\s+(.+)$/i);
	if (om) {
		const t = OPEN_TARGETS.find(([re]) => re.test(om[1]));
		if (t) return [{ tool: ['Open', t[1]], out: 'Launched', act: () => openTarget(t[1]) }, { text: 'Done — it is on your screen now.' }];
	}
	for (const [re, titleRe] of [[/garment|try-?on|vton|outfit/i, /Garments2Look/], [/extdm|video pred/i, /ExtDM/], [/emotion/i, /Emotion-Director/], [/dra|motion transfer/i, /DRA-MTransfer/]]) {
		const i = PAPERS.findIndex(p => titleRe.test(p.title));
		if (i >= 0 && has(re)) return [{ tool: ['Read', `papers/${PAPERS[i].short}.pdf`], out: 'Read 1 paper' }, { text: paperText(PAPERS[i]) + '\nOpening it in the Document Viewer…', act: () => openPaper(i) }];
	}
	if (has(/hello|^hi\b|hey/i)) return [{ text: "Hi there! 👋 I'm Junyao's scripted assistant. Ask me about his research, papers, news, or how to reach him." }];
	if (has(/claude|real ai|are you (an )?ai|gpt|llm|model/i)) return [{ text: "Honest answer: I'm not a real AI. Every reply here is pre-written — this window only borrows the look of a coding-agent CLI for fun." }];
	if (has(/news|recent|latest|update/i)) return [
		{ tool: ['Read', 'news.ics'], out: `Read ${NEWS.length} events` },
		{ text: 'Most recent:\n' + NEWS.slice(0, 5).map(n => `  <b>${n[0]}</b>  ${n[2]}`).join('\n') },
	];
	if (has(/contact|email|mail|reach|wechat/i)) return [{ text:
		`📧 <span class="mail">${EMAIL}</span>\n🐙 GitHub: <a href="https://github.com/JunyaoHu" target="_blank">JunyaoHu</a>\n🎓 <a href="${SCHOLAR}" target="_blank">Google Scholar</a>\nEmail is the fastest way to reach me.` }];
	if (has(/collab|hire|job|intern|work with/i)) return [{ text:
		"I'd love to collaborate on anything around creative content — fashion, film, video, art or emotion-aware generation. Drop me an email with a short intro and idea 🥰" }];
	if (has(/film|movie|festival/i)) return [{ text:
		'🎬 One of my films was selected as a <b>Finalist</b> at the First AMC AI Film Festival (HKUST, 2025). On the research side: ExtDM (video prediction) and DRA-MTransfer (motion transfer).' }];
	if (has(/blog|post|article|note/i)) return [
		{ tool: ['Glob', 'blog/**/*.md'], out: `Found ${POSTS.length} files` },
		{ text: POST_CATS.map(c => `  📁 <b>${c}</b> — ${POSTS.filter(p => p.category === c).length} posts`).join('\n') + '\nSay "open blog" to browse them.' },
	];
	if (has(/photo|gallery|picture|album/i)) return [{ tool: ['Open', 'Photos'], out: 'Launched', act: () => openWin('gallery') }, { text: `${ALBUMS.length} albums: ${ALBUMS.map(a => a.name).join(', ')} 📷` }];
	if (has(/message|guestbook|comment|leave a note/i)) return [{ tool: ['Open', 'Guestbook'], out: 'Launched', act: () => openWin('guestbook') }, { text: 'The guestbook is open — it is the same message board as the classic homepage. Say hi! 👋' }];
	if (FRIENDS.length && has(/friend|people|peers/i)) return [
		{ tool: ['Read', 'src/data/friends.ts'], out: `Found ${FRIENDS.length} friends` },
		{ text: [...new Set(FRIENDS.map(f => f.category))].map(c => `  <b>${c}</b> — ${FRIENDS.filter(f => f.category === c).length}`).join('\n') + '\nOpening Contacts…', act: () => openWin('friends') },
	];
	if (has(/fashion|cloth/i)) return [{ text:
		"👔 I work at PolyU's School of Fashion and Textiles. My main fashion project is <b>Garments2Look</b> — outfit-level virtual try-on with layering and accessories. Ask me \"tell me about Garments2Look\"." }];
	if (has(/paper|publication|research|working on|work on|cvpr/i)) return [
		{ tool: ['Read', 'src/data/papers.ts'], out: `Found ${PAPERS.length} papers` },
		{ text: 'I work on <b>creative content production</b> with generative models — fashion, video, emotion and art.\n\n' +
			PAPERS.map(p => `  <b>${p.venue.padEnd(8)}</b> ${p.short} — ${p.role.toLowerCase()}`).join('\n') +
			'\n\nAsk about any of them by name, or say "open papers".' },
	];
	if (/^\/?whoami$/i.test(q) || has(/who|about|yourself|introduce|junyao/i)) return [{ tool: ['Read', 'README.md'], out: 'Read 20 lines' }, { text:
		"I'm <b>Junyao Hu</b>, a first-year Ph.D. student at PolyU's School of Fashion and Textiles, supervised by Dr. Xingxing Zou and co-supervised by Prof. Calvin Wong Wai-keung. Before that I studied at CUMT. I like turning AI into things people can see and feel ✨" }];
	return [{ text: `Hmm, I'm only a scripted demo and don't know how to answer "${esc(q)}" yet. Try <b>/help</b>, or ask about papers, news or contact.` }];
}

/* ═══════════ boot: splash → desktop ═══════════ */
// 开机动画每个浏览会话只放一次：从经典页或新标签页回来时直接进桌面
const BOOT_KEY = 'desk-booted';
const booted = (() => { try { return sessionStorage.getItem(BOOT_KEY) === '1'; } catch (e) { return false; } })();
document.getElementById('wall').innerHTML = genWallpaper();
tick();
const splash = document.getElementById('splash');
if (booted) splash.remove();
else {
	try { sessionStorage.setItem(BOOT_KEY, '1'); } catch (e) {}
	const endSplash = () => {
		if (!splash.isConnected) return;
		splash.classList.add('fade'); setTimeout(() => splash.remove(), 500);
		setTimeout(() => openWin('about'), 350);
	};
	splash.onclick = endSplash;
	setTimeout(endSplash, 1500);
}
</script>
</body>
</html>
