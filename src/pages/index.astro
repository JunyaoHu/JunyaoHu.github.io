---
// 主页：Ubuntu 风格的桌面版；经典主页在 /classic
// 论文 / 新闻 / 相册 / 友链在构建时从现有数据文件注入，改数据文件即可同步
import { getAllPapersSorted, getPaperAuthorFilterRole, SELF_AUTHOR_NAME } from '../data/papers';
import { getCollection } from 'astro:content';
import { newsItems } from '../data/homepage';
import { galleryConfig } from '../data/gallery';
import { getEnabledFriends } from '../data/friends';
import { siteVisibility } from '../data/siteVisibility';
import { TWIKOO_CDN, getTwikooConfig } from '../data/commentConfig';
import { buildAlbumGalleryImages, listGalleryImageFiles, resolveCoverFilename } from '../utils/galleryImages';

const escapeHtml = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

const papers = getAllPapersSorted().map((p) => ({
	venue: p.venue ?? '',
	title: p.title,
	year: p.year,
	filter: getPaperAuthorFilterRole(p),
	authors: p.authors.map((a) => ({ name: a.name, self: a.name === SELF_AUTHOR_NAME, eq: !!a.equalContrib, corr: !!a.corresponding })),
	tldr: p.tldr ?? '',
	demo: p.demo?.src || '',
	links: p.links.map((l) => [l.label, l.href]),
}));

const news = newsItems.map((n) => ({ date: n.date, category: n.category, html: n.html ?? escapeHtml(n.text ?? '') }));

const albums = siteVisibility.gallery
	? (
			await Promise.all(
				galleryConfig.albums.map(async (a) => {
					const images = await buildAlbumGalleryImages(a.id);
					const files = listGalleryImageFiles(a.id);
					const cover = images[files.indexOf(resolveCoverFilename(a.cover, files) ?? '')] ?? images[0];
					return { id: a.id, name: a.name, cover: cover?.thumb ?? '', images: images.map((i) => ({ thumb: i.thumb, full: i.full })) };
				}),
			)
		).filter((a) => a.images.length)
	: [];

const friends = siteVisibility.friends
	? getEnabledFriends().map((f) => ({ name: f.title, avatar: f.imgurl, url: f.siteurl, org: (f.affiliations ?? []).join(' · '), category: f.category }))
	: [];

// 博客分类在站内是中文名，桌面版显示英文；未列出的分类原样显示
const CATEGORY_EN: Record<string, string> = {
	课外学习: 'Self-study',
	CUMT课程笔记: 'CUMT Course Notes',
	生活杂记: 'Life',
	开发项目: 'Projects',
	刷题记录: 'Coding Practice',
	博客指南: 'Blog Guide',
	文章示例: 'Examples',
};
const posts = siteVisibility.blog
	? (await getCollection('blog'))
			.sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf())
			.map((p) => ({
				id: p.id,
				title: p.data.title,
				date: p.data.publishedDate.toISOString().slice(0, 10),
				category: p.data.category ? (CATEGORY_EN[p.data.category] ?? p.data.category) : 'Uncategorized',
			}))
	: [];

const twikooCfg = getTwikooConfig();
const twikoo = twikooCfg.enabled ? { cdn: TWIKOO_CDN, envId: twikooCfg.envId, region: twikooCfg.region ?? '', lang: twikooCfg.lang ?? '' } : null;

const deskData = JSON.stringify({ papers, news, albums, friends, posts, twikoo }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Junyao Hu</title>
<meta name="description" content="Junyao Hu — first-year Ph.D. student at PolyU School of Fashion and Textiles. Creative content production with generative AI." />
<link rel="icon" href="/favicon.ico" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@400;500;700&family=Ubuntu+Mono:wght@400;700&display=swap" rel="stylesheet" />
<style is:inline>
	:root {
		--orange: #e95420;
		--bar: #0f0f0f;
		--win: #fafafa;
		--head: #ebebeb;
		--line: rgba(0, 0, 0, 0.1);
		--text: #3d3d3d;
		--muted: #7a7a7a;
		--sel: rgba(233, 84, 32, 0.12);
		--font: 'Ubuntu', system-ui, sans-serif;
		--mono: 'Ubuntu Mono', 'JetBrains Mono', Consolas, monospace;
		--top: 32px;
	}
	* { box-sizing: border-box; }
	html, body { margin: 0; height: 100%; overflow: hidden; font-family: var(--font); color: var(--text); background: #000; font-size: 14px; }
	button { font: inherit; color: inherit; }
	a { color: var(--orange); }
	.dim { color: var(--muted); }

	/* ── wallpaper ── */
	#wall { position: fixed; inset: 0; z-index: 0; }
	#wall svg { width: 100%; height: 100%; display: block; }

	/* ── splash ── */
	#splash { position: fixed; inset: 0; z-index: 9000; background: #000; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28px; color: #fff; transition: opacity .5s; }
	#splash .mark { font-size: 40px; font-weight: 300; }
	#splash .mark b { color: var(--orange); font-weight: 700; }
	.dots { display: flex; gap: 10px; }
	.dots i { width: 8px; height: 8px; border-radius: 50%; background: #fff; opacity: .25; animation: dot 1s infinite; }
	.dots i:nth-child(2) { animation-delay: .15s; } .dots i:nth-child(3) { animation-delay: .3s; } .dots i:nth-child(4) { animation-delay: .45s; } .dots i:nth-child(5) { animation-delay: .6s; }
	@keyframes dot { 30% { opacity: 1; background: var(--orange); } }
	.fade { opacity: 0; pointer-events: none; }


	/* ── top bar ── */
	#topbar { position: fixed; left: 0; right: 0; top: 0; height: var(--top); z-index: 8900; background: var(--bar); color: #fff; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 8px; user-select: none; }
	#appName { padding: 0 12px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	#topbar .pill { height: 24px; padding: 0 12px; border-radius: 99px; border: 0; background: transparent; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
	#topbar .pill:hover, #topbar .pill.on { background: rgba(255, 255, 255, .16); }
	#clock { font-weight: 500; cursor: default; }
	.tray { justify-self: end; display: flex; gap: 2px; align-items: center; }
	.tray svg { width: 16px; height: 16px; fill: #fff; }

	.menu { position: fixed; z-index: 8950; min-width: 230px; padding: 8px; border-radius: 14px; background: #2a2a2a; color: #fff; box-shadow: 0 14px 40px rgba(0, 0, 0, .5); display: none; }
	.menu.open { display: block; animation: pop .14s ease-out; }
	.menu .mi { padding: 9px 12px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 10px; }
	.menu .mi:hover { background: rgba(255, 255, 255, .1); }
	.menu a.mi { color: #fff; text-decoration: none; }
	.menu hr { border: 0; border-top: 1px solid rgba(255, 255, 255, .1); margin: 6px 4px; }
	#sysmenu { right: 8px; top: calc(var(--top) + 6px); }

	/* ── desktop icons ── */
	#desktop { position: fixed; inset: var(--top) 0 0 0; z-index: 1; }
	#dicons { position: absolute; inset: 14px; pointer-events: none; }
	.dcol { position: absolute; display: grid; grid-auto-flow: column; grid-template-rows: repeat(auto-fill, 98px); grid-auto-columns: 96px; gap: 4px; pointer-events: auto; }
	.dcol.left { left: 0; top: 0; bottom: 110px; }
	.dcol.right { right: 0; top: 0; bottom: 0; direction: rtl; } /* 竖排；放不下时向左再开一列 */
	.dcol.right .di { direction: ltr; }
	.dcol.trash { left: 0; bottom: 0; }
	.di { padding: 8px 4px; border-radius: 10px; display: flex; flex-direction: column; align-items: center; gap: 6px; color: #fff; text-align: center; font-size: 13px; text-shadow: 0 1px 3px rgba(0, 0, 0, .7); cursor: pointer; user-select: none; }
	.di svg { width: 50px; height: 50px; filter: drop-shadow(0 2px 4px rgba(0, 0, 0, .3)); }
	.di:hover { background: rgba(255, 255, 255, .15); }

	/* ── windows (Yaru-ish) ── */
	.win { position: absolute; min-width: 320px; min-height: 200px; background: var(--win); border-radius: 12px; box-shadow: 0 0 0 1px rgba(0, 0, 0, .18), 0 18px 50px rgba(0, 0, 0, .45); display: flex; flex-direction: column; overflow: hidden; resize: both; animation: pop .16s ease-out; }
	@keyframes pop { from { transform: scale(.95); opacity: 0; } }
	.win.min { display: none; }
	.win.max { left: 0 !important; top: 0 !important; width: 100% !important; height: 100% !important; border-radius: 0; resize: none; }
	.hb { height: 46px; flex: none; display: flex; align-items: center; padding: 0 8px 0 12px; background: var(--head); border-bottom: 1px solid var(--line); cursor: grab; user-select: none; gap: 8px; }
	.win:not([data-active='1']) .hb { background: #f2f2f2; color: #999; }
	.hb:active { cursor: grabbing; }
	.hb .t { flex: 1; text-align: center; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-left: 84px; }
	.hb .ctl { display: flex; gap: 8px; }
	.hb .ctl button { width: 24px; height: 24px; border-radius: 50%; border: 0; background: rgba(0, 0, 0, .08); cursor: pointer; display: grid; place-items: center; padding: 0; }
	.hb .ctl button:hover { background: rgba(0, 0, 0, .16); }
	.hb .ctl button.x:hover { background: var(--orange); color: #fff; }
	.hb .ctl svg { width: 10px; height: 10px; stroke: currentColor; stroke-width: 1.6; fill: none; }
	.content { flex: 1; overflow: auto; position: relative; }
	.pad { padding: 16px 20px; line-height: 1.65; }

	/* files */
	.files { display: flex; height: 100%; }
	.files aside { width: 180px; flex: none; background: #f0f0f0; border-right: 1px solid var(--line); padding: 8px; }
	.files aside .pl { padding: 7px 10px; border-radius: 8px; cursor: pointer; display: flex; gap: 10px; align-items: center; font-size: 13.5px; }
	.files aside .pl svg { width: 18px; height: 18px; }
	.files aside .pl:hover { background: rgba(0, 0, 0, .05); }
	.files aside .pl.on { background: var(--sel); color: var(--orange); font-weight: 500; }
	.files main { flex: 1; overflow: auto; display: flex; flex-direction: column; }
	.crumb { display: flex; align-items: center; gap: 6px; padding: 8px 12px; border-bottom: 1px solid var(--line); font-size: 13px; color: var(--muted); }
	.crumb .c { padding: 3px 10px; border-radius: 99px; background: rgba(0, 0, 0, .06); color: var(--text); cursor: pointer; }
	.crumb .c:last-child { font-weight: 700; }
	.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 6px; padding: 14px; }
	.fi { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 10px 6px; border-radius: 10px; cursor: pointer; text-align: center; font-size: 12.5px; line-height: 1.3; word-break: break-word; color: inherit; text-decoration: none; }
	.fi svg { width: 56px; height: 56px; }
	.fi:hover { background: var(--sel); }
	.rows { padding: 6px 10px; }
	.row { display: grid; grid-template-columns: 32px minmax(0, 1fr) 90px; gap: 10px; align-items: center; padding: 9px 8px; border-radius: 8px; cursor: pointer; }
	.row:hover { background: var(--sel); }
	.row svg { width: 28px; height: 28px; }
	.row .nm { font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.row .sub { color: var(--muted); font-size: 12px; }
	.row.post { color: inherit; text-decoration: none; }
	.row .dt { justify-self: end; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
	.row .vn { justify-self: end; font-size: 12px; font-weight: 700; color: #fff; background: var(--orange); border-radius: 6px; padding: 1px 8px; }
	.foot { margin-top: auto; padding: 8px 14px; color: var(--muted); font-size: 12px; border-top: 1px solid var(--line); }

	/* text editor */
	.editor { font: 15px/1.7 var(--mono); padding: 10px 0; }
	.ln { display: flex; }
	.ln .no { width: 44px; flex: none; text-align: right; padding-right: 14px; color: #b0b0b0; user-select: none; }
	.ln .tx { white-space: pre-wrap; padding-right: 16px; }
	.md-h { color: var(--orange); font-weight: 700; }
	.md-q { color: #888; font-style: italic; }
	.md-b { color: #77216f; }

	/* document viewer */
	.doc { background: #d8d8d8; min-height: 100%; padding: 18px; }
	.page { max-width: 640px; margin: 0 auto; background: #fff; padding: 26px 30px; box-shadow: 0 2px 10px rgba(0, 0, 0, .15); line-height: 1.6; }
	.page h2 { margin: 6px 0 10px; font-size: 19px; line-height: 1.35; color: #222; }
	.page img { width: 100%; border-radius: 6px; margin: 10px 0; border: 1px solid var(--line); }
	.btns { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
	.btns a { padding: 5px 14px; border-radius: 99px; background: #f0f0f0; text-decoration: none; color: var(--text); font-size: 13px; }
	.btns a:hover { background: var(--orange); color: #fff; }
	.chip { display: inline-block; padding: 0 8px; border-radius: 6px; background: var(--orange); color: #fff; font-size: 12px; font-weight: 700; }

	/* photos */
	.photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 4px; padding: 4px; }
	.photos img { width: 100%; aspect-ratio: 1; object-fit: cover; cursor: zoom-in; display: block; }

	/* filter chips (publications / friends) */
	.chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 14px 0; }
	.chips button { border: 1px solid var(--line); background: #fff; border-radius: 99px; padding: 3px 12px; font-size: 12.5px; cursor: pointer; }
	.chips button:hover { border-color: var(--orange); }
	.chips button.on { background: var(--orange); border-color: var(--orange); color: #fff; }
	.chips button small { opacity: .7; margin-left: 2px; }
	.authors { color: #555; font-size: 13px; margin-bottom: 4px; }
	.authors b { color: #222; text-decoration: underline; text-underline-offset: 2px; }

	/* photo albums */
	.albums { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; padding: 14px; }
	.album { cursor: pointer; border-radius: 10px; padding: 6px; }
	.album:hover { background: var(--sel); }
	.album .cv { aspect-ratio: 1; border-radius: 8px; background: #ddd center/cover; box-shadow: 4px 4px 0 -1px #fff, 4px 4px 0 0 #ccc, 0 1px 3px rgba(0, 0, 0, .15); }
	.album .an { margin-top: 10px; font-weight: 500; }
	.album .ac { font-size: 12px; color: var(--muted); }
	.ph-bar { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-bottom: 1px solid var(--line); }
	.ph-bar button { border: 0; background: rgba(0, 0, 0, .06); border-radius: 8px; padding: 4px 12px; cursor: pointer; }
	.ph-bar button:hover { background: rgba(0, 0, 0, .12); }

	/* contacts (friends) */
	.contacts { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px; padding: 12px 14px 14px; }
	.ct { display: flex; gap: 10px; align-items: center; padding: 10px; border-radius: 10px; border: 1px solid var(--line); background: #fff; color: inherit; text-decoration: none; }
	.ct:hover { border-color: var(--orange); background: #fff8f5; }
	.ct img, .ct .ini { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; flex: none; background: #eee; }
	.ct .ini { display: grid; place-items: center; font-weight: 700; color: #fff; background: linear-gradient(135deg, #e95420, #77216f); }
	.ct .nm { font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.ct .og { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.ct > div { min-width: 0; }

	/* web browser (站内页面在桌面里的窗口中打开) */
	.br { display: flex; flex-direction: column; height: 100%; }
	.br-bar { display: flex; align-items: center; gap: 6px; padding: 6px 8px; background: #f0f0f0; border-bottom: 1px solid var(--line); }
	.br-bar button { width: 30px; height: 30px; flex: none; border: 0; border-radius: 8px; background: transparent; cursor: pointer; font-size: 16px; line-height: 1; }
	.br-bar button:hover { background: rgba(0, 0, 0, .08); }
	.br-bar button:disabled { opacity: .3; cursor: default; background: transparent; }
	.br-bar .ext { display: inline-flex; align-items: center; height: 30px; flex: none; padding: 0 12px; border: 1px solid var(--line); border-radius: 99px; background: #fff; color: var(--text); font-size: 13px; white-space: nowrap; text-decoration: none; }
	.br-bar .ext:hover { border-color: var(--orange); color: var(--orange); }
	.br-url { flex: 1; min-width: 0; padding: 5px 14px; border-radius: 99px; background: #fff; border: 1px solid var(--line); font-size: 13px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.br-url b { color: var(--text); font-weight: 500; }
	.br iframe { flex: 1; width: 100%; border: 0; background: #fff; }
	body.dragging iframe { pointer-events: none; }

	/* guestbook */
	.gb { padding: 18px 22px 24px; }
	.gb h3 { margin: 0 0 4px; font-size: 18px; }
	.gb > p { margin: 0 0 14px; }
	.gb img { margin: 0; }

	/* news (calendar agenda) */
	.agenda { padding: 8px 18px 18px; }
	.agenda h4 { margin: 18px 0 6px; font-size: 13px; color: var(--muted); letter-spacing: .06em; }
	.ev { display: grid; grid-template-columns: 54px 4px 1fr; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--line); }
	.ev .d { text-align: right; font-weight: 700; color: #555; font-size: 13px; line-height: 1.2; }
	.ev .d small { display: block; font-weight: 400; color: var(--muted); }
	.ev .bar { border-radius: 4px; }
	.ev .tx { line-height: 1.5; }

	/* ── Junyao Code (Claude Code style chat) ── */
	.cc { background: #1f1e1d; color: #e8e6e3; font: 14.5px/1.55 var(--mono); height: 100%; display: flex; flex-direction: column; }
	.cc .dim { color: #8f8b85; }
	.cc-scroll { flex: 1; overflow: auto; padding: 14px 16px 6px; scrollbar-width: thin; scrollbar-color: #4a4743 transparent; }
	.cc-scroll::-webkit-scrollbar { width: 10px; }
	.cc-scroll::-webkit-scrollbar-track { background: transparent; }
	.cc-scroll::-webkit-scrollbar-thumb { background: #4a4743; border: 3px solid #1f1e1d; border-radius: 99px; }
	.cc-scroll::-webkit-scrollbar-thumb:hover { background: #d97757; }
	.cc-scroll::-webkit-scrollbar-corner { background: transparent; }
	.cc-welcome { display: flex; gap: 16px; align-items: center; border: 1px solid #d97757; border-radius: 10px; padding: 12px 16px; }
	.cc-welcome .ttl { font-weight: 700; }
	.cc-welcome .ttl span { color: #d97757; }
	.clawd { width: 66px; flex: none; }
	.clawd .eyes { transform-origin: center 5.5px; animation: blink 4s infinite; }
	@keyframes blink { 0%, 94%, 100% { transform: scaleY(1); } 97% { transform: scaleY(.1); } }
	.busy .clawd { animation: hop .5s infinite; }
	@keyframes hop { 50% { transform: translateY(-4px); } }
	.cc-tips { margin: 12px 2px 4px; }
	.cc-tips ol { margin: 4px 0 0; padding-left: 22px; }
	.cc-log > div { margin-top: 12px; }
	.cc-user { color: #a9a49c; background: #2b2a28; border-radius: 6px; padding: 4px 10px; white-space: pre-wrap; }
	.cc-msg { display: flex; gap: 8px; }
	.cc-msg .dot, .cc-tool .dot { flex: none; }
	.cc-msg .body { white-space: pre-wrap; }
	.cc-msg .body a { color: #e3a07f; }
	.cc .mail { color: #e3a07f; user-select: all; }
	.cc-msg .body b { color: #fff; }
	.cc-tool .dot { color: #6cc070; }
	.cc-tool b { color: #fff; }
	.cc-out { color: #8f8b85; padding-left: 4px; margin-top: 0 !important; white-space: pre-wrap; }
	.cc-spin { color: #d97757; }
	.cc-spin .s { display: inline-block; width: 1ch; }
	.cc-box { margin: 6px 12px 0; border: 1px solid #5a5651; border-radius: 10px; display: flex; align-items: center; gap: 10px; padding: 8px 12px; }
	.cc-box:focus-within { border-color: #8f8b85; }
	.cc-box span { color: #8f8b85; }
	.cc-box input { flex: 1; background: transparent; border: 0; outline: 0; color: #e8e6e3; font: inherit; }
	.cc-box input::placeholder { color: #6f6b66; }
	.cc-foot { display: flex; justify-content: space-between; gap: 10px; padding: 6px 14px 10px; font-size: 12.5px; color: #8f8b85; flex-wrap: wrap; }
	.cc-chips { display: flex; gap: 6px; flex-wrap: wrap; }
	.cc-chips button { border: 1px solid #4a4743; background: transparent; color: #cfcac3; border-radius: 99px; padding: 2px 10px; cursor: pointer; font: 12.5px var(--mono); }
	.cc-chips button:hover { border-color: #d97757; color: #fff; }

	/* ── lightbox ── */
	#lightbox { position: fixed; inset: 0; background: rgba(0, 0, 0, .88); z-index: 9500; display: none; align-items: center; justify-content: center; cursor: zoom-out; }
	#lightbox img { max-width: 92vw; max-height: 88vh; border-radius: 8px; }

	/* 登录前隐藏桌面图标 */

	@media (max-width: 680px) {
		.dcol { grid-template-rows: repeat(auto-fill, 90px); grid-auto-columns: 84px; }
		.win { left: 6px !important; top: 6px !important; width: calc(100% - 12px) !important; height: calc(100% - 12px) !important; resize: none; }
		.win.max { left: 0 !important; top: 0 !important; width: 100% !important; height: 100% !important; }
		.hb .t { padding-left: 0; text-align: left; }
		.files aside { display: none; }
		#topbar .hide-sm { display: none; }
	}
</style>
</head>
<body>

